# ========== DISTRESS SCOUT CONFIGURATION ==========

# Node Environment
NODE_ENV=development
PORT=3001

# API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend
REACT_APP_API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# Database (When upgrading from mock)
DATABASE_URL=postgresql://user:password@localhost:5432/distress_scout
REDIS_URL=redis://localhost:6379

# Email Service (for notifications)
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=noreply@distressscout.com

# Optional: Skip Tracing Service Integration
TRESTLE_API_KEY=your_trestle_key_here
TRESTLE_API_URL=https://api.trestle.com

# Optional: Property Data Integration
ZILLOW_API_KEY=your_zillow_key_here

# Logging
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_here

# Feature Flags
ENABLE_PREMIUM_BETA=false
ENABLE_MOBILE_APP=false
