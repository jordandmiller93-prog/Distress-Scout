# ========== DISTRESS SCOUT CONFIGURATION ==========

# Node Environment
NODE_ENV=development
PORT=3001

# API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend
REACT_APP_API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# Database (When upgrading from mock)
# DATABASE_URL=postgresql://user:password@localhost:5432/distress_scout
REDIS_URL=redis://localhost:6379

# Email Service (for notifications)
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=noreply@distressscout.com

# Optional: Skip Tracing Service Integration
TRESTLE_API_KEY=your_trestle_key_here
TRESTLE_API_URL=https://api.trestle.com

# Optional: Property Data Integration
ZILLOW_API_KEY=your_zillow_key_here

# Logging
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_here

# Feature Flags
ENABLE_PREMIUM_BETA=false
ENABLE_MOBILE_APP=false

# Auth
JWT_SECRET=generate_with_openssl_rand_hex_32

# 2Captcha (for future county-records/skip-trace scraping)
CAPTCHA_API_KEY=your_2captcha_key_here

# Twilio SMS (Outreach Agent)
TWILIO_ACCOUNT_SID=your_account_sid_AC...
TWILIO_API_KEY_SID=your_api_key_sid_SK...
TWILIO_API_KEY_SECRET=your_api_key_secret_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ElevenLabs voice agent webhook
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_secret

# ElevenLabs API (agent management / TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_key
